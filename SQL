import mysql.connector as tor

my=tor.connect(host='localhost',user='root',password='12345678')
h=my.cursor()

h.execute("create database if not exists register")
h.execute("use register")

h.execute("""create table if not exists users(
USERNAME varchar(50),
PASSWORD varchar(50))""")

h.execute("""create table if not exists trains(
TRAIN_NO int,
TRAIN_NAME varchar(50),
SOURCE varchar(50),
DEST varchar(50),
TIME varchar(50),
FARE int,
AVAILABLE_SEATS int)""")

h.execute("""create table if not exists passengers(
NAME varchar(50),
AGE int,
GENDER varchar(1),
TRAIN_NO int,
TRAIN_NAME varchar(50),
BOOKING_DATE varchar(50),
PNR varchar(20),
SEAT_NO int)""")

h.execute("""create table if not exists bookings(
PNR varchar(20),
PASSENGER_NAME varchar(50),
AGE int,
GENDER varchar(1),
TRAIN_NO int,
SEAT_NO int,
FARE int,
BOOKING_DATE varchar(50))""")

my.commit()

print("TABLES CREATED SUCCESSFULLY")

my.close()
